<html>
<head>
<title>Drinks</title>

<style>
body{
    font-family: Arial;
    text-align:center;
    background:#f5f5f5;
}

#drinks{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
}

.card{
    margin:10px;
    padding:10px;
    width:180px;
    background:#f0f8ff;
    border-radius:15px;
    box-shadow:2px 2px 10px rgba(0,0,0,0.2);
}

.card img{
    width:150px;
    border-radius:10px;
}
</style>

</head>

<body>

<h1>🍹 Drinks 🍸</h1>

<div id="mojdiv">Text</div>

<div id="drinks"></div>

<script>

const mojDivVJS = document.getElementById("mojdiv");
mojDivVJS.textContent = "Ahoj z JS";

setInterval(() => {
    mojDivVJS.style.backgroundColor = "red";
}, 1000);

setInterval(() => {
    mojDivVJS.style.backgroundColor = "blue";
}, 2000);


// FETCH z BoozeAPI
fetch("https://boozeapi.com/api/v1/cocktails")
.then((response) => response.json())
.then((data) => {

    const drinksDiv = document.getElementById("drinks");

    data.data.forEach((drink) => {

        const card = document.createElement("div");
        card.className = "card";

        const name = document.createElement("b");
        name.textContent = drink.name;

        const img = document.createElement("img");
        img.src = drink.image;

        card.appendChild(name);
        card.appendChild(document.createElement("br"));
        card.appendChild(img);

        drinksDiv.appendChild(card);
    });

})
.catch((error) => {
    console.log("Chyba:", error);
});

</script>

</body>
</html>
